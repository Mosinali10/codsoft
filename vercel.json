{
  "buildCommand": "npm install --prefix codsoft-web/client && npm run build --prefix codsoft-web/client",
  "outputDirectory": "codsoft-web/client/dist",
  "installCommand": "echo 'Skipping root install'",
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/recommend",
      "destination": "/api/recommend"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
